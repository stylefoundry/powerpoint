<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Properties xmlns="http://schemas.openxmlformats.org/officeDocument/2006/extended-properties"
  xmlns:vt="http://schemas.openxmlformats.org/officeDocument/2006/docPropsVTypes">
  <TotalTime>313</TotalTime>
  <Words>3106</Words>
  <Application>Microsoft Office PowerPoint</Application>
  <PresentationFormat>Widescreen</PresentationFormat>
  <Paragraphs>141</Paragraphs>
  <Slides><%= slides.length %></Slides>
  <Notes><%= notes_slides.length %></Notes>
  <HiddenSlides>0</HiddenSlides>
  <MMClips>0</MMClips>
  <ScaleCrop>false</ScaleCrop>
  <HeadingPairs>
    <vt:vector size="6" baseType="variant">
      <vt:variant>
        <vt:lpstr>Theme</vt:lpstr>
      </vt:variant>
      <vt:variant>
        <vt:i4><%= themes.length %></vt:i4>
      </vt:variant>
      <vt:variant>
        <vt:lpstr>Slide Titles</vt:lpstr>
      </vt:variant>
      <vt:variant>
        <vt:i4><%= slides.length %></vt:i4>
      </vt:variant>
      <vt:variant>
        <vt:lpstr>Fonts Used</vt:lpstr>
      </vt:variant>
      <vt:variant>
        <vt:i4>3</vt:i4>
      </vt:variant>
    </vt:vector>
  </HeadingPairs>
  <TitlesOfParts>
    <vt:vector size="<%= slides.length + themes.length + 3 %>" baseType="lpstr">
      <% themes.each do |theme| %>
      <vt:lpstr><%= theme[:name] %></vt:lpstr>
      <% end %>
      <% slides.each do |slide| %>
      <vt:lpstr><%= slide.title.nil? ? "PowerPoint Presentation" : slide.title.strip.encode(:xml => :text) %></vt:lpstr>
      <% end %>
      <vt:lpstr>Aptos</vt:lpstr>
      <vt:lpstr>Arial</vt:lpstr>
      <vt:lpstr>Wingdings</vt:lpstr>
    </vt:vector>
  </TitlesOfParts>
  <Company></Company>
  <LinksUpToDate>false</LinksUpToDate>
  <SharedDoc>false</SharedDoc>
  <HyperlinksChanged>false</HyperlinksChanged>
  <AppVersion>16.0000</AppVersion>
</Properties>
