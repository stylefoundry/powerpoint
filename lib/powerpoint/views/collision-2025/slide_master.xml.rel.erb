<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">
  <% @last_layout_id = master_rel[:layouts].map { |layout| layout[:id] }.max %>
  <% master_rel[:layouts].each do |layout| %>
  <Relationship Id="rId<%= layout[:id] %>"
    Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout"
    Target="<%= layout[:file_path] %>"/>
  <% end %>
  <% @last_embed_id = master_rel[:embeds].map { |embed| embed[:id] }.max %>
  <% master_rel[:embeds].each do |embed| %>
  <Relationship Id="rId<%= embed[:id] + @last_layout_id %>"
    Type="<%= embed[:content_type] %>"
    Target="<%= embed[:file_path] %>" />
  <% end %>
  <Relationship Id="rId<%= @last_layout_id + (@last_embed_id || 0) + 1 %>"
    Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/theme"
    Target="<%= master_rel[:theme] %>"/>

  <Relationship Id="ffLogoSmall"
    Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image"
    Target="../media/image1.png" />
  <Relationship Id="rId16"
    Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image"
    Target="../media/image1.png" />
</Relationships>
