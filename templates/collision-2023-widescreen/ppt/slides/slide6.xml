icFrameLocks noGrp="1"/></p:cNvGraphicFramePr><p:nvPr><p:ph idx="12"/></p:nvPr></p:nvGraphicFramePr><p:xfrm><a:off x="6096000" y="1881188"/><a:ext cx="5676900" cy="4608512"/></p:xfrm><a:graphic><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/chart"><c:chart xmlns:c="http://schemas.openxmlformats.org/drawingml/2006/chart" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" r:id="rId2"/></a:graphicData></a:graphic></p:graphicFrame><p:sp><p:nvSpPr><p:cNvPr id="19" name="Text Placeholder 18"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{6E0DE548-A7E2-2B50-69B0-4A014DBB88E4}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="13"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="6114519" y="1304492"/><a:ext cx="5640037" cy="193899"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB"/><a:t>"Which of these websites/apps have you used in the past month?" TikTok (</a:t></a:r><a:r><a:rPr lang="en-GB" err="1"/><a:t>Douyin</a:t></a:r><a:r><a:rPr lang="en-GB"/><a:t>)</a:t></a:r></a:p></p:txBody></p:sp><p:sp><p:nvSpPr><p:cNvPr id="17" name="Text Placeholder 16"><a:extLst><a:ext uri="{FF2B5EF4-FFF2-40B4-BE49-F238E27FC236}"><a16:creationId xmlns:a16="http://schemas.microsoft.com/office/drawing/2014/main" id="{7E9C7B4C-C8D9-7A85-D1C3-8CAD3D03329A}"/></a:ext></a:extLst></p:cNvPr><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="11"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm><a:off x="314768" y="1304492"/><a:ext cx="5498203" cy="5220134"/></a:xfrm></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-GB" dirty="0"/><a:t>Choice explosion has allowed consumers to be more selective</a:t></a:r></a:p><a:p><a:r><a:rPr lang="en-GB" dirty="0"/><a:t>Connected shoppers are ever more aware of their expanding options, and growing competition in practically every industry vertical gives consumers the power of choice. With more alternatives available, loyalty has been harder for brands to earn. Nearly two-thirds (65%) of global consumers stopped using a brand in the past year for at least one reason asked about in our research, and the most common reason was "not good value for money" (Foresight Factory, 2022). Brands must continually demonstrate their value to customers.</a:t></a:r></a:p><a:p><a:endParaRPr lang="en-GB" dirty="0"/></a:p></p:txBody></p:sp></p:spTree><p:extLst><p:ext uri="{BB962C8B-B14F-4D97-AF65-F5344CB8AC3E}"><p14:creationId xmlns:p14="http://schemas.microsoft.com/office/powerpoint/2010/main" val="4056883167"/></p:ext></p:extLst></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr><p:transition/></p:sld>